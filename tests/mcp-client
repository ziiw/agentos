#!/usr/bin/env python3
# A minimal MCP client for tests, run inside a sandbox:
#   mcp-client SERVER CALL...   where CALL is METHOD or tools/call:TOOL:JSONARGS
# Starts `agent mcp SERVER`, initializes, then makes each call in turn,
# waiting for its answer, and prints one line per call.
import json
import subprocess
import sys

server, calls = sys.argv[1], sys.argv[2:]
proc = subprocess.Popen(["/run/agentos/agent", "mcp", server], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
next_id = 0


def request(method, params=None):
    global next_id
    next_id += 1
    proc.stdin.write(json.dumps({"jsonrpc": "2.0", "id": next_id, "method": method, "params": params or {}}) + "\n")
    proc.stdin.flush()
    for line in proc.stdout:
        msg = json.loads(line)
        if msg.get("id") == next_id:
            return msg
    sys.exit(f"{server}: connection closed")


request("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "mcp-client", "version": "1"}})
for c in calls:
    if c.startswith("sneak:"):
        # A tool call sent as a notification (no id): it must not run.
        _, tool, args = c.split(":", 2)
        proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "tools/call", "params": {"name": tool, "arguments": json.loads(args)}}) + "\n")
        proc.stdin.flush()
        print(f"sneaked {tool}")
    elif c.startswith("tools/call:"):
        _, tool, args = c.split(":", 2)
        msg = request("tools/call", {"name": tool, "arguments": json.loads(args)})
        result = msg.get("result", {})
        out = " ".join(part.get("text", "") for part in result.get("content", []))
        print(f"{tool}: {out}" + (" [error]" if result.get("isError") else ""))
    else:
        msg = request(c)
        if c == "tools/list" and "result" in msg:
            print("tools: " + ",".join(t["name"] for t in msg["result"]["tools"]))
        else:
            print(f"{c}: {json.dumps(msg.get('result', msg.get('error')))}")
proc.stdin.close()
proc.wait()
