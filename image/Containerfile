# agentos: a Linux distribution for running AI agents as transactions.
#
# Fedora bootc with the agent runtime built in: the OS itself is this
# container image, updated atomically (`bootc upgrade`) and rolled back the
# same way (`bootc rollback`).
#
#   podman build -f image/Containerfile -t localhost/agentos .
#
# Turn it into a bootable disk, or move an existing bootc machine onto it:
# see image/README.md.

# (Amazon's public mirror of the official image: Docker Hub refuses anonymous pulls from busy CI runners)
FROM public.ecr.aws/docker/library/rust:1.94-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
# Set by CI to the commit being built (there's no .git in the build context).
ARG AGENTOS_REV=unknown
ENV AGENTOS_REV=${AGENTOS_REV}
RUN cargo build --release --locked

FROM quay.io/fedora/fedora-bootc:42

# What agents (and agentos itself) reach for: git for the outbox, curl,
# python3, and util-linux for unshare (and script(1), packaged separately).
# cloud-init applies a cloud's user data at first boot (users, SSH keys) and
# does nothing on a machine that has none.
# Xvfb and xdotool are for `agent do --display`: a screen of its own for an agent
# that drives a graphical program, which you can watch and act on. The three small
# X tools are what the end-to-end tests draw with.
RUN dnf -y install git-core curl python3 util-linux util-linux-script cloud-init \
        xorg-x11-server-Xvfb xdotool xmessage xwininfo xev xdpyinfo && dnf clean all

COPY --from=build /src/target/release/agent /usr/bin/agent
COPY image/rootfs/ /
COPY packaging/agentd.service /usr/lib/systemd/user/agentd.service

RUN bootc container lint
